# Copia este archivo a .env y ajusta los valores. El archivo .env NO se sube al repositorio (.gitignore).
# El agente corre contra Ollama local: no requiere claves ni credenciales de ningún servicio externo.

# Servidor de Ollama (http o https)
OLLAMA_HOST=http://localhost:11434
# Modelo de chat y de embeddings (ollama pull <modelo>)
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Segundos máximos de espera por respuesta del modelo
OLLAMA_TIMEOUT=120
# Umbral de similitud coseno del RAG (0 a 1); más alto = más estricto
RAG_UMBRAL=0.60
# Máximo de sesiones de conversación en memoria en la API
API_MAX_SESIONES=200
